# Secrets are read ONLY from the environment (never from config files, never logged).
# Referenced from config/sources.yaml via  auth: {type: header, name: Authorization, env: SHOP_TOKEN}
#   or  auth: {type: basic, user_env: SHOP_USER, password_env: SHOP_PASS}
SHOP_TOKEN=
PRICECOMPARE_UA=pricecompare/1.0 (contact: you@example.com)
# Only if telegram_enabled: true in settings.yaml
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
